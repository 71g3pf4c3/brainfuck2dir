{
  lib,
  stdenv,
  zig,
  scdoc,
  installShellFiles,
  zigTarget ? null,
  optimize ? "ReleaseSafe",
}:

let
  # Single source of truth for the version: build.zig.zon.
  version =
    let
      zonText = builtins.readFile ./build.zig.zon;
      versionLine = lib.findFirst (line: lib.hasInfix ".version = \"" line) null (
        lib.splitString "\n" zonText
      );
    in
    if versionLine == null then
      throw "package.nix: cannot find .version in build.zig.zon"
    else
      lib.head (lib.match ".*\.version = \"([^\"]+)\".*" versionLine);
in
stdenv.mkDerivation {
  pname = "brainfuck2dir";
  inherit version;

  src = ./.;

  nativeBuildInputs = [
    zig
    scdoc
    installShellFiles
  ];

  dontConfigure = true;

  # zig build install writes straight into $out via --prefix; the manual
  # is rendered next to it, and the install phase only adds completions.
  buildPhase = ''
    runHook preBuild

    export ZIG_GLOBAL_CACHE_DIR="$TMPDIR/zig-global-cache"
    export ZIG_LOCAL_CACHE_DIR="$TMPDIR/zig-local-cache"
    export HOME="$TMPDIR"

    zig build install \
      --prefix "$out" \
      -Doptimize=${optimize} \
      ${lib.optionalString (zigTarget != null) "-Dtarget=${zigTarget}"} \
      --cache-dir "$ZIG_LOCAL_CACHE_DIR" \
      --global-cache-dir "$ZIG_GLOBAL_CACHE_DIR" \
      --summary all

    mkdir -p "$out/share/man/man1"
    scdoc < docs/b2d.1.scd > "$out/share/man/man1/b2d.1"

    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    installShellCompletion \
      --bash completions/b2d.bash \
      --zsh completions/_b2d \
      --fish completions/b2d.fish
    runHook postInstall
  '';

  meta = {
    description = "Materialize brainfuck source as directory trees (the converter itself is brainfuck)";
    longDescription = ''
      Reads brainfuck source and writes it out as a tree of
      directories and files: runs of a command become files named
      NNNc with the run length as contents, loops become directories
      named NNNloop. The conversion logic is a ~98KB brainfuck
      program generated by tools/gen_b2d.py and executed by a
      built-in interpreter; the Zig binary is only the VM, the CLI
      and the materializer. Output is json2dir-scheme JSON, so it
      pipes straight into json2dir(1).
    '';
    homepage = "https://github.com/71g3pf4c3/brainfuck2dir";
    license = lib.licenses.gpl3Plus;
    mainProgram = "b2d";
    platforms = lib.platforms.unix;
  };
}
